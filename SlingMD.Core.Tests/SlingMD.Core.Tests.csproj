    <Compile Include="..\SlingMD.Tests\Services\Formatting\EmailAddressParserTests.cs" Link="Linked\EmailAddressParserTests.cs" />
    <Compile Include="..\SlingMD.Tests\Services\Formatting\FileNameSanitizerTests.cs" Link="Linked\FileNameSanitizerTests.cs" />
