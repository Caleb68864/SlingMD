<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Cross-platform tests for SlingMD.Core. Runs anywhere the .NET SDK does:
      dotnet test SlingMD.Core.Tests
    It is deliberately not in SlingMD.sln, so the Windows MSBuild/VSTest build does not need this SDK.

    Tests for classes that live in SlingMD.Core are compiled from SlingMD.Tests (linked below), so
    they keep running under VSTest on Windows as well. Tests only this project has live here.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <IsPackable>false</IsPackable>
    <AssemblyName>SlingMD.Core.Tests</AssemblyName>
    <RootNamespace>SlingMD.Core.Tests</RootNamespace>
    <!-- The linked tests are written for C# 7.3 / xunit 2.4 and trip newer analyzer advice. -->
    <NoWarn>$(NoWarn);xUnit1026;xUnit2013;xUnit1031;xUnit2009;xUnit2017;xUnit2012</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\SlingMD.Core\SlingMD.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\SlingMD.Tests\Services\Formatting\BodyCleanerServiceTests.cs" Link="Linked\BodyCleanerServiceTests.cs" />
    <Compile Include="..\SlingMD.Tests\Services\Formatting\ContactAliasWriterTests.cs" Link="Linked\ContactAliasWriterTests.cs" />
    <Compile Include="..\SlingMD.Tests\Services\Formatting\ContactIndexTests.cs" Link="Linked\ContactIndexTests.cs" />
